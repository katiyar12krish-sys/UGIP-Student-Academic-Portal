# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: optional. Password for the first admin account (min 8 chars, letters + digits).
# If empty, a random temporary password is generated on first run and written to data/initial-credentials.txt
ADMIN_PASSWORD=""
# ADMIN_PASSWORD_RESET: set to 1 for one start to force the admin password to ADMIN_PASSWORD (use when the database already exists). Remove it after logging in.
ADMIN_PASSWORD_RESET=""

# TRUST_PROXY: set to 1 when running behind nginx / a load balancer / Cloud Run (so rate limiting sees real client IPs).
# INSECURE_COOKIES=1 only if you run production mode over plain http (not recommended).

# ---- Step 3 ----
# MFA_REQUIRED_ROLES: roles that MUST use an authenticator app (TOTP). Default "admin,faculty". Use "" for nobody, or add student,parent.
MFA_REQUIRED_ROLES="admin,faculty"
# SMS_PROVIDER: none (default, SMS off) | console (development only: prints the code in the server log).
# A real provider needs DLT registration first (see docs/STEP3.md).
SMS_PROVIDER="none"
# GRIEVANCE_EMAIL: shown in the privacy notice as the grievance contact (DPDP Act).
GRIEVANCE_EMAIL=""

# ---- Step 4: reminders and push notifications ----
# Make the keys with:  npm run vapid   (paste the three lines it prints). Without them the bell list still works, but no phone push is sent.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:principal@your-college-domain"
# Attendance alerts go out when overall attendance falls below this percentage (default 75).
ATTENDANCE_MIN_PERCENT="75"

# ---- Step 9: study materials and file upload ----
# MAX_UPLOAD_MB: largest file a teacher can upload (default 10). Behind nginx also set client_max_body_size a little higher (see docs/STEP9.md).
MAX_UPLOAD_MB="10"

# Step 13: set to 0 to switch off students' own chats with teachers (parent <-> teacher chats keep working)
# CHAT_STUDENT_CHAT=1

# ---- Step 14 ----
# BACKUP_KEEP: how many backups `npm run backup` keeps (default 14). BACKUP_DIR: where they go (default ./backups; better another disk).
# Before going live delete ADMIN_PASSWORD / ADMIN_PASSWORD_RESET / DEV_STAFF_PASSWORD (see docs/DEPLOY.md). The server warns at start if they are still set.

# ---- Step 18: academic year, automatic class promotion, sample data ----
# PROMOTION_DATE: day (MM-DD) on which ALL classes move up one year automatically, after the May-June UBTER result.
#   1st year -> 2nd year, 2nd -> 3rd, 3rd year -> "Passed Out". Default 07-01 (1 July). Allowed: June to August.
#   In January students move from the odd to the even semester by themselves. The admin can also do both by hand
#   (Admin -> Academic Year & Promotion) and undo the last promotion.
PROMOTION_DATE="07-01"
# PROMOTION_AUTO: set to 0 to switch the automatic promotion off (then use the admin button every year).
PROMOTION_AUTO="1"
# DEMO_DATA: set to 0 BEFORE the first start to skip the random sample 1st / 2nd year data.
# (Admin -> Academic Year & Promotion -> "Delete all sample data" removes it later in one click.)
DEMO_DATA="1"
